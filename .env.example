# Firebase web app configuration.
# Copy this file to .env and fill in the values from:
#   Firebase Console > Project settings (gear icon) > Your apps > Web app > SDK setup and configuration > Config
#
# These values are NOT secrets - they ship in the browser bundle by design.
# Access control is enforced by Firestore security rules, not by hiding these.
# They are kept out of git so each team member points at their own project if needed.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=expedia-clone---team11.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=expedia-clone---team11
REACT_APP_FIREBASE_STORAGE_BUCKET=expedia-clone---team11.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Country code used when formatting the phone number for OTP sign-in.
REACT_APP_PHONE_COUNTRY_CODE=+1
